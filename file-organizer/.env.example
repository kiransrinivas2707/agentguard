# Copy to .env and load it in your shell. Never commit real secrets.
FILE_ORGANIZER_DATA=./data
FILE_ORGANIZER_SECRET=replace-with-a-long-random-string
FILE_ORGANIZER_CLASSIFIER=opencode
FILE_ORGANIZER_MODEL=opencode/deepseek-v4.1-flash-free
FILE_ORGANIZER_OPENCODE_AGENT=file-classifier
FILE_ORGANIZER_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FILE_ORGANIZER_MAX_UPLOAD=26214400
FILE_ORGANIZER_CLASSIFY_TIMEOUT=120
# Optional. Semicolon-separated absolute folders the local importer may read.
# Leave empty to disable server-folder scanning.
FILE_ORGANIZER_SCAN_ROOTS=
# New users start with automatic organization on at 80% confidence.
FILE_ORGANIZER_AUTO_ORGANIZE_DEFAULT=true
# Google Drive/Photos OAuth (not active until a connector is configured).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Planned callback used by docs/GOOGLE_SETUP.md.
GOOGLE_REDIRECT_URI=http://localhost:8000/api/integrations/google/callback
# Set true when serving over HTTPS.
FILE_ORGANIZER_COOKIE_SECURE=false
